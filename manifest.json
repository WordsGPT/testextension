{
  "manifest_version": 3,
  "name": "Verba — Immersion Reader & Vocabulary",
  "short_name": "Verba",
  "version": "1.2.0",
  "description": "Read websites, EPUB/PDF/MOBI books, and watch videos with dual captions across 24 languages. Includes an adaptive CEFR placement test, offline dictionaries, and Anki sync.",
  "browser_specific_settings": {
    "gecko": {
      "id": "verba-reader@verba.org",
      "strict_min_version": "109.0"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Verba",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    }
  },
  "options_ui": {
    "page": "dashboard.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "dist/background.js",
    "scripts": ["dist/background.js"],
    "type": "module"
  },
  "permissions": [
    "storage",
    "unlimitedStorage",
    "activeTab",
    "scripting",
    "contextMenus",
    "alarms"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*", "file://*/*"],
      "js": ["dist/content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "dictionaries/*.json",
        "samples/*",
        "icons/*",
        "dist/*.js",
        "dist/*.mjs"
      ],
      "matches": ["<all_urls>"]
    }
  ]
}
